@{
    Layout = null;
}

<!DOCTYPE html>

<html dir="rtl" lang="ar-eg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>تسجيل دخول</title>
    <link rel="icon" type="image/x-icon" href="~/4500.ico" />
    <link rel="stylesheet" href="~/Content/bootstrap.css" />
    <link rel="stylesheet" href="~/Content/bootstrap-grid.css" />
    <link href="~/Content/LoginStyle.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-3.6.0.min.js"></script>
    <script src="~/Scripts/SweatAlertJs.js"></script>

    <script src="~/Scripts/loginjs.js"></script>

</head>
<body>
    <!-- Video Background -->
    <div class="video-background">
        <video autoplay muted loop>
            <source src="~/Images/video-login.webm" type="video/webm">
            Your browser does not support the video tag.
        </video>
    </div>

    <div class="container-fluid bg">
        <div class="row justify-content-center">
            <div class="">
                <!--form Start-->
                <form id="loginForm" method="post" class="form-container">
                    <img src="~/Images/4500.ico" class="mb-4" />
                    <h1 class="mb-5 fs-2">الحرب الإلكترونية</h1>
                    <div class="form-group">
                        @Html.Label("إسم المستخدم", htmlAttributes: new { @class = "control-label" })
                        @Html.Editor("username", new { htmlAttributes = new { @class = "form-control", @placeholder = "إسم المستخدم" } })
                        @Html.ValidationMessage("username", "", new { @class = "text-danger" })
                    </div>
                    <div class="form-group">
                        @Html.Label("كلمة السر", htmlAttributes: new { @class = "control-label" })
                        @Html.Editor("password", new { htmlAttributes = new { @class = "form-control", @type = "password", @placeholder = "كلمة السر" } })
                        @Html.ValidationMessage("password", "", new { @class = "text-danger" })
                    </div>
                    <div class="form-group mt-5 fs-3">
                        <button type="submit" class="btn btn-block add-btn">
                            تسجيل دخول
                            <span class="glyphicon glyphicon-log-in"></span>
                        </button>
                    </div>
                </form>

                <!--form End-->
            </div>
        </div>
    </div>
</body>
</html>
