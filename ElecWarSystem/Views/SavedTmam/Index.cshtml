@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/tmam_gathering_layout.cshtml";
}
<link href="~/Content/StyleCss/SaveTmam.css" rel="stylesheet" />
<div style="min-height: 28vh;">
    <h2 class="h2 mb-5">تحميل جميع التقارير</h2>

    <div class="mt-4">
        @Html.ActionLink("تحميل كل التقارير عن اليوم", actionName: "DownloadAllReports", controllerName: "TmamGatheringReports", routeValues: null, htmlAttributes: new { @class = "add-btn btn-block text-decoration-none mt-4", @id = "downloadAllReportsBtn" })
    </div>
</div>
<script type="text/javascript">
    document.getElementById('downloadAllReportsBtn').addEventListener('click', function (e) {
        e.preventDefault();

        // عرض رسالة التحميل مع شريط التقدم
        Swal.fire({
            title: 'جاري التحميل...',
            html: `
                <div class="progress-container">
                    <div id="progressBar" class="progress-bar">
                        <div id="progress" class="progress-fill"></div>
                    </div>
                </div>
                <p id="loadingText" class="loading-text">يرجى الانتظار حتى يتم إكمال التحميل</p>
            `,
            allowOutsideClick: false,
            showConfirmButton: false,
            didOpen: () => {
                let progressElement = document.getElementById('progress');
                let width = 0;
                let interval = setInterval(function () {
                    if (width >= 100) {
                        clearInterval(interval);

                        // تحديث رسالة النجاح وإخفاء شريط التقدم
                        Swal.update({
                            title: 'تم التحميل بنجاح!',
                            html: `<p class="success-text">تم تحميل جميع التقارير بنجاح.</p>`,
                            icon: 'success',
                            showConfirmButton: true,
                        });
                    } else {
                        width += 10;
                        progressElement.style.width = width + '%';
                    }
                }, 500);
            }
        });

        // بدء التحميل بعد وقت قصير
        setTimeout(function () {
            window.location.href = '@Url.Action("DownloadAllReports", "TmamGatheringReports")';
        }, 2000);
    });
</script>

<style>
    .progress-container {
        width: 100%;
        background-color: #f0f0f0;
        border-radius: 10px;
        overflow: hidden;
        height: 10px;
        margin-top: 20px;
    }

    .progress-bar {
        width: 100%;
        height: 10px;
    }

    .progress-fill {
        width: 0;
        height: 100%;
        background-color: #4CAF50;
        transition: width 0.4s ease;
        border-radius: 10px;
    }

    .loading-text {
        margin-top: 10px;
        font-size: 14px;
        color: #333;
        text-align: center;
    }

    .success-text {
        font-size: 16px;
        color: #4CAF50;
        text-align: center;
    }
</style>
